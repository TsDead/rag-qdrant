# Бесплатный ключ Groq — console.groq.com (без карты).
GROQ_API_KEY=gsk_...
# (опц.) модель ответа
# LLM_MODEL=openai/gpt-oss-20b

# Векторная БД. Если QDRANT_URL не задан — локальный движок на диске (без Docker).
# Для «боевого» сервера (docker compose up): раскомментируй строку ниже.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_PATH=./qdrant_data
